
@{
    ViewData["Title"] = "Мнемосхема зерносховища";

    var uk = new System.Globalization.CultureInfo("uk-UA");
    DateTime today = DateTime.Today;
    DateTime first = new DateTime(today.Year, today.Month, 1);
    int offset = ((int)first.DayOfWeek + 6) % 7;
    int days = DateTime.DaysInMonth(today.Year, today.Month);
}


<div class="container-fluid px-0">
    
<div class="d-flex align-items-start gap-2">

<div class="flex-grow-1 text-start" style="min-width: 0;">

    <div style="position: relative; display: inline-block; max-width: 100%;">

        <img src="/images/grain-storage-scheme.png"
             alt="Схема технологічного процесу автоматизованої системи зберігання зерна"
             class="img-fluid"
             style="display: block; width: auto; max-width: 100%; height: auto; max-height: calc(100vh - 65px);" />

        <span id="temperature-value"
      style="position: absolute; left: 62.4%; top: 40.5%; transform: translate(-50%, -50%); color: white; font-size: 13px; white-space: nowrap;">—</span>

<span id="humidity-value"
      style="position: absolute; left: 62.4%; top: 52.5%; transform: translate(-50%, -50%); color: white; font-size: 13px; white-space: nowrap;">—</span>

<span id="level-value"
      style="position: absolute; left: 62.5%; top: 65.5%; transform: translate(-50%, -50%); color: white; font-size: 13px; white-space: nowrap;">—</span>

    </div>

</div>

    <div class="flex-shrink-0 d-flex justify-content-center" style="width: 300px; transform: translateX(-15px);">
        <table class="cal">
            <caption>
                @uk.TextInfo.ToTitleCase(today.ToString("MMMM yyyy", uk))
            </caption>
            <thead>
                <tr>
                    <th>Пн</th>
                    <th>Вт</th>
                    <th>Ср</th>
                    <th>Чт</th>
                    <th>Пт</th>
                    <th>Сб</th>
                    <th>Нд</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    @for (int i = 0; i < offset; i++)
                    {
                        <td></td>
                    }

                    @for (int d = 1; d <= days; d++)
                    {
                        bool isWeekend = (offset + d - 1) % 7 >= 5;
                        string css = d == today.Day
                            ? "today"
                            : (isWeekend ? "weekend" : "");

                        <td class="@css">@d</td>

                        if ((offset + d) % 7 == 0 && d < days)
                        {
                            @:</tr><tr>
                        }
                    }
                </tr>
            </tbody>
        </table>
    </div>

</div>

</div>

@section Scripts {
    <script src="~/js/scheme.js"></script>
}

