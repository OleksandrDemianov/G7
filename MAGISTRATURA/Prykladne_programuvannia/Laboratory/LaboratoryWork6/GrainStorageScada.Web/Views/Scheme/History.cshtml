@model List<GrainStorageScada.Web.Data.SensorSample>

@{
    ViewData["Title"] = "Історія";
}

<h2>Історія показань</h2>

<a asp-action="Index">← до мнемосхеми</a>

<table class="table table-sm mt-2">
    <tr>
        <th>Час</th>
        <th>Топік</th>
        <th>Значення</th>
        <th>Хто зберіг</th>
    </tr>

    @foreach (var s in Model)
    {
        <tr>
            <td>@s.MeasuredAtUtc.ToLocalTime().ToString("dd.MM HH:mm:ss")</td>
            <td>@s.Topic</td>
            <td>@s.Value @s.Unit</td>
            <td>@s.SavedBy</td>
        </tr>
    }
</table>

